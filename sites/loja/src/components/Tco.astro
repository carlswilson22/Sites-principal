---
interface Props { costs: { city_consumption?: number; road_consumption?: number; avg_maintenance?: number; annual_insurance?: number } }
const { costs } = Astro.props;
const hasFuel = Boolean(costs.city_consumption || costs.road_consumption);
---
<div class="sim" data-tco data-city={costs.city_consumption || ''} data-road={costs.road_consumption || ''} data-maint={costs.avg_maintenance || ''} data-ins={costs.annual_insurance || ''}>
  <div class="sim__grid">
    {hasFuel && <label class="field">Quilômetros por mês<input name="km" type="number" min="0" step="100" inputmode="numeric" value="1000" /></label>}
    {hasFuel && <label class="field">Preço do combustível (R$/litro)<input name="fuel" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Quanto você paga" /></label>}
    {hasFuel && <label class="field">Uso na cidade (%)<input name="city" type="number" min="0" max="100" step="10" inputmode="numeric" value="60" /></label>}
    <label class="field">IPVA anual (R$, opcional)<input name="ipva" type="number" min="0" step="50" inputmode="numeric" placeholder="Do seu estado" /></label>
  </div>
  <button class="btn btn--ghost" type="button" data-tco-run>Calcular custo por mês</button>
  <div class="sim__out" role="status" data-tco-out></div>
  <p class="muted" style="margin:0;font-size:0.9rem">Estimativa com os consumos, a manutenção e o seguro informados pela loja e os valores que você digitou. Não inclui financiamento, multas nem depreciação.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tco]').forEach(root => {
    const out = root.querySelector<HTMLElement>('[data-tco-out]')!;
    const money = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    const num = (value?: string) => (value ? Number(value) : 0);
    const field = (name: string) => num((root.querySelector(`[name=${name}]`) as HTMLInputElement | null)?.value);
    root.querySelector('[data-tco-run]')!.addEventListener('click', () => {
      const city = num(root.dataset.city), road = num(root.dataset.road);
      const rows: [string, number][] = [];
      if (city || road) {
        const fuel = field('fuel');
        if (!fuel) { out.textContent = 'Informe o preço do combustível que você paga.'; return; }
        const share = Math.min(1, Math.max(0, field('city') / 100));
        // Consumo médio ponderado pelo uso: média harmônica entre cidade e estrada
        const kmPerLiter = city && road ? 1 / (share / city + (1 - share) / road) : (city || road);
        rows.push([`Combustível (${kmPerLiter.toFixed(1).replace('.', ',')} km/l)`, (field('km') * 12 / kmPerLiter * fuel) / 12]);
      }
      if (num(root.dataset.maint)) rows.push(['Manutenção média', num(root.dataset.maint) / 12]);
      if (num(root.dataset.ins)) rows.push(['Seguro', num(root.dataset.ins) / 12]);
      if (field('ipva')) rows.push(['IPVA', field('ipva') / 12]);
      const total = rows.reduce((sum, [, value]) => sum + value, 0);
      out.innerHTML = '';
      const list = document.createElement('dl'); list.className = 'specs';
      for (const [label, value] of [...rows, ['Total estimado por mês', total] as [string, number]]) {
        const box = document.createElement('div'); const dt = document.createElement('dt'); const dd = document.createElement('dd');
        dt.textContent = label; dd.textContent = money(value); box.append(dt, dd); list.append(box);
      }
      out.append(list);
    });
  });
</script>
