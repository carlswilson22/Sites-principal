---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Página não encontrada" noindex>
  <div class="section wrap">
    <h1>Não achamos esta página</h1>
    <p style="margin-top:1rem">O endereço pode ter mudado ou o veículo já foi vendido.</p>
    <p><a class="btn btn--accent" href="/estoque">Ver o estoque</a></p>
  </div>
</Base>
