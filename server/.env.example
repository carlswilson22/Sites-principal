# Configuração de UMA instalação (um arquivo por cliente). Nunca versionar o .env real.
NODE_ENV=production
PORT=3001
MERCHANT_TIER=1

# Origens do site da loja (separadas por vírgula). Obrigatório em produção.
CORS_ORIGINS=https://www.loja-exemplo.com.br
# true somente atrás do proxy reverso (Caddy)
TRUST_PROXY=true

# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Uma chave DIFERENTE por cliente. Guardar fora do servidor também.
DATA_ENCRYPTION_KEY=

# Dados da loja (usados nos documentos e na exportação)
STORE_NAME=
STORE_CNPJ=
STORE_CITY=
STORE_UF=

# Endereço público do site (usado no link de recuperação de senha). Padrão: primeira origem do CORS.
SITE_URL=https://www.loja-exemplo.com.br

# Chave da EMPRESA (nunca entregar ao cliente). Só ela altera módulos e franquias. 16+ caracteres.
ADMIN_API_KEY=

# Fotos (padrão: pasta media dentro de DATA_DIR)
# MEDIA_DIR=/var/data/loja/media

# Dados fictícios: somente na instalação de demonstração
SEED_DEMO=false

# E-mail que recebe os avisos de novo contato, caso a loja ainda não o tenha cadastrado no painel
# LEADS_EMAIL=vendas@loja-exemplo.com.br
# E-mail da empresa fornecedora: recebe cópia dos avisos de franquia de IA
# PROVIDER_EMAIL=

# Integrações (opcionais). Sem elas o sistema informa "nao_configurado"; nunca finge funcionar.
# RESEND_API_KEY=
# EMAIL_FROM=Loja <contato@loja-exemplo.com.br>
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
