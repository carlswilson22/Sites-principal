{
  "name": "sites-modelos-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:portal": "npm --workspace=portal run dev",
    "dev:dealership": "npm --workspace=auto-dealership run dev",
    "dev:luxury": "npm --workspace=luxury-dealership run dev",
    "dev:popular": "npm --workspace=popular-dealership run dev",
    "build": "node scripts/build-all.mjs",
    "build:portal": "npm --workspace=portal run build",
    "test:merchant": "node --test packages/merchant-core/tests/*.test.mjs",
    "test:server": "node scripts/check-server.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:dev": "node scripts/check-dev.mjs",
    "preview": "vite preview --base /Sites-principal/ --outDir dist --host 127.0.0.1 --port 4173",
    "check:runtime": "node --experimental-vm-modules scripts/check-runtime.mjs"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
